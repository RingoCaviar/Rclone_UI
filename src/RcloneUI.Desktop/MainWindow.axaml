<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RcloneUI.Desktop.Presentation"
        x:Class="RcloneUI.Desktop.MainWindow"
        x:DataType="vm:DesktopShellState"
        Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Title="Rclone UI" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="64,*" ColumnDefinitions="232,*">
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" Padding="16,22">
      <Grid RowDefinitions="Auto,24,*,Auto">
        <StackPanel>
          <TextBlock Text="Rclone UI" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EditionLabel}" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <ListBox Grid.Row="2" SelectedIndex="0" SelectionChanged="NavigationChanged" Background="Transparent" BorderThickness="0">
          <ListBoxItem Tag="Home" Content="{Binding NavHome}" />
          <ListBoxItem Tag="Remotes" Content="{Binding NavRemotes}" />
          <ListBoxItem Tag="Transfers" Content="{Binding NavTransfers}" />
          <ListBoxItem Tag="Browser" Content="{Binding NavBrowser}" />
          <ListBoxItem Tag="Mounts" Content="{Binding NavMounts}" />
          <ListBoxItem Tag="Schedules" Content="{Binding NavSchedules}" />
          <ListBoxItem Tag="Activity" Content="{Binding NavActivity}" />
          <ListBoxItem Tag="Settings" Content="{Binding NavSettings}" />
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="8">
          <Border Classes="status" Background="{DynamicResource CardBrush}">
            <StackPanel>
              <TextBlock Text="{Binding HostHeading}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding StatusBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="status" Background="{DynamicResource CardBrush}">
            <StackPanel>
              <TextBlock Text="{Binding VaultHeading}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VaultStatusLabel}" Foreground="{Binding VaultStatusBrush}" />
              <Button IsVisible="{Binding CanLockVault}" Content="{Binding LockVaultLabel}" Margin="0,6,0,0" Click="LockVaultClicked" />
            </StackPanel>
          </Border>
          <Button Content="{Binding ExitLabel}" HorizontalAlignment="Stretch" Click="ExitClicked" />
          <Button Content="{Binding QuitAllLabel}" HorizontalAlignment="Stretch" Click="QuitAllClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Padding="28,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SessionLabel}" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding NotificationsLabel}" Margin="8,0" />
        <Button Grid.Column="2" Content="中 / EN" Click="LanguageClicked" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28" Spacing="20">
        <Border IsVisible="{Binding NeedsAttention}" Classes="attention">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding AttentionTitle}" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding AttentionDetail}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBox IsVisible="{Binding IsVaultLocked}" Text="{Binding MasterPassword}" PasswordChar="●" PlaceholderText="{Binding MasterPasswordHint}" MaxLength="1024" Margin="0,10,16,0" AutomationProperties.Name="Master Password" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding AttentionAction}" Click="AttentionClicked" />
          </Grid>
        </Border>

        <StackPanel IsVisible="{Binding IsHome}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding HomeHeading}" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HomeDescription}" Opacity="0.68" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{Binding NewTaskLabel}" Click="NewTaskClicked" />
          </Grid>
          <UniformGrid Columns="4" Rows="1">
            <Button Classes="shortcut" Content="{Binding ShortcutTransfer}" Tag="Transfers" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutBrowse}" Tag="Browser" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutMount}" Tag="Mounts" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutRemote}" Tag="Remotes" Click="ShortcutClicked" />
          </UniformGrid>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TransferCardHeading}" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding RunningTasksLabel}" /></Grid>
                <Border Classes="empty"><TextBlock Text="{Binding HomeTransferStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding RemoteHealthHeading}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HomeRemoteStatus}" TextWrapping="Wrap" />
                <Button Content="{Binding OpenRemoteWizardLabel}" Tag="Remotes" Click="ShortcutClicked" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsJourney}" Spacing="18">
          <TextBlock Text="{Binding JourneyHeading}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding JourneyDescription}" FontSize="15" Opacity="0.72" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding JourneyStatus}" FontWeight="SemiBold" FontSize="17" />
              <TextBlock Text="{Binding JourneyActionHint}" TextWrapping="Wrap" />
              <Border IsVisible="{Binding HasActionNotification}" Classes="status" Background="{DynamicResource CardBrush}" AutomationProperties.LiveSetting="Polite">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding ActionNotificationTitle}" Foreground="{Binding ActionNotificationBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ActionNotificationMessage}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding IsRemoteAdvancedVisible}" Spacing="10">
                <TextBlock Text="{Binding QuickAddHeading}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding RemoteSetupKinds}" SelectedItem="{Binding RemoteSetupKind}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding RemoteSetupKindHint}" AutomationProperties.Name="Remote setup method" />
                <StackPanel IsVisible="{Binding IsTokenRemoteSetup}" Spacing="10">
                  <TextBox PlaceholderText="{Binding RemoteDisplayNameHint}" Text="{Binding RemoteDisplayName}" AutomationProperties.Name="Remote display name" />
                  <ComboBox ItemsSource="{Binding TokenProviderTypes}" SelectedItem="{Binding RemoteProviderType}" AutomationProperties.Name="Remote provider" />
                  <TextBox PlaceholderText="{Binding RemoteTokenHint}" Text="{Binding RemoteToken}" PasswordChar="●" MaxLength="16384" AutomationProperties.Name="Remote token" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsConnectionRemoteSetup}" Spacing="10">
                  <TextBlock Text="{Binding ConnectionRemoteHeading}" FontWeight="SemiBold" />
                  <TextBox PlaceholderText="{Binding RemoteDisplayNameHint}" Text="{Binding RemoteDisplayName}" AutomationProperties.Name="Remote display name" />
                  <ComboBox ItemsSource="{Binding ConnectionProtocols}" SelectedItem="{Binding ConnectionProtocol}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding ConnectionProtocolHint}" AutomationProperties.Name="Connection protocol" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox PlaceholderText="{Binding ConnectionHostHint}" Text="{Binding ConnectionHost}" AutomationProperties.Name="Connection host" />
                    <TextBox Grid.Column="1" Width="90" PlaceholderText="{Binding ConnectionPortHint}" Text="{Binding ConnectionPort}" AutomationProperties.Name="Connection port" />
                  </Grid>
                  <TextBox PlaceholderText="{Binding ConnectionUserHint}" Text="{Binding ConnectionUser}" AutomationProperties.Name="Connection username" />
                  <TextBox PlaceholderText="{Binding ConnectionPasswordHint}" Text="{Binding ConnectionPassword}" PasswordChar="●" MaxLength="16384" AutomationProperties.Name="Connection password" />
                  <TextBox IsVisible="{Binding IsSftpHostKeyVisible}" PlaceholderText="{Binding ConnectionHostKeyHint}" Text="{Binding ConnectionHostKeyFingerprint}" MaxLength="1024" AutomationProperties.Name="SFTP host key fingerprint" />
                  <CheckBox IsVisible="{Binding IsFtpsConnection}" Content="{Binding ConnectionInsecureCertificate}" IsChecked="{Binding ConnectionSkipCertificateVerification}" />
                </StackPanel>
                <TextBlock Text="{Binding RemoteSetupHelpText}" TextWrapping="Wrap" Opacity="0.7" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsRemoteJourney}" Spacing="8">
                <TextBlock Text="{Binding SavedRemotesHeading}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding SavedRemotes}" SelectedItem="{Binding SelectedSavedRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding SavedRemotesHeading}" AutomationProperties.Name="Saved Remotes" />
                <TextBox Text="{Binding RemoteDeleteConfirmation}" PlaceholderText="{Binding RemoteDeleteConfirmationHint}" AutomationProperties.Name="Remote delete confirmation" />
                <Button IsEnabled="{Binding CanDeleteSelectedRemote}" Content="{Binding DeleteRemoteLabel}" Click="DeleteRemoteClicked" AutomationProperties.Name="Delete selected Remote" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsTransferJourney}" Spacing="10">
                <TextBlock Text="{Binding TransferFormHeading}" FontWeight="SemiBold" />
                <StackPanel IsVisible="{Binding IsTransferAdvancedVisible}" Spacing="6">
                  <TextBlock Text="{Binding TransferModeHeading}" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding TransferModeOptions}" SelectedItem="{Binding TransferModeChoice}" DisplayMemberBinding="{Binding DisplayName}" AutomationProperties.Name="Transfer mode" />
                  <TextBlock Text="{Binding TransferModeHelpText}" TextWrapping="Wrap" Opacity="0.72" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding MaximumTransferMiB}" PlaceholderText="{Binding MaximumTransferMiBHint}" AutomationProperties.Name="Maximum transfer MiB" />
                    <TextBox Grid.Column="1" Text="{Binding MaximumDurationMinutes}" PlaceholderText="{Binding MaximumDurationMinutesHint}" AutomationProperties.Name="Maximum duration minutes" />
                  </Grid>
                </StackPanel>
                <Grid IsVisible="{Binding IsRemoteSourceVisible}" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding CopySourceRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding SourceRemoteHint}" AutomationProperties.Name="Copy source Remote" />
                  <TextBox Grid.Column="1" PlaceholderText="{Binding SourcePathHint}" Text="{Binding CopySourcePath}" AutomationProperties.Name="Copy source path" />
                </Grid>
                <Grid IsVisible="{Binding IsDownloadMode}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding DownloadDestinationPath}" IsReadOnly="True" PlaceholderText="{Binding DownloadFolderHint}" AutomationProperties.Name="Download destination folder" />
                  <Button Grid.Column="1" Content="{Binding PickFolderLabel}" Click="PickDownloadFolderClicked" />
                </Grid>
                <Grid IsVisible="{Binding IsUploadMode}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding UploadSourcePath}" IsReadOnly="True" PlaceholderText="{Binding UploadFolderHint}" AutomationProperties.Name="Upload source folder" />
                  <Button Grid.Column="1" Content="{Binding PickFolderLabel}" Click="PickUploadFolderClicked" />
                </Grid>
                <Grid IsVisible="{Binding IsRemoteCopyMode}" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding CopyDestinationRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding DestinationRemoteHint}" AutomationProperties.Name="Copy destination Remote" />
                  <TextBox Grid.Column="1" PlaceholderText="{Binding DestinationPathHint}" Text="{Binding CopyDestinationPath}" AutomationProperties.Name="Copy destination path" />
                </Grid>
                <Grid IsVisible="{Binding IsUploadMode}" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding CopyDestinationRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding DestinationRemoteHint}" AutomationProperties.Name="Upload destination Remote" />
                  <TextBox Grid.Column="1" PlaceholderText="{Binding DestinationPathHint}" Text="{Binding CopyDestinationPath}" AutomationProperties.Name="Upload destination path" />
                </Grid>
                <TextBlock Text="{Binding CopyStatus}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsBrowserJourney}" Spacing="10">
                <ComboBox ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding BrowserRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding BrowserRemoteHint}" AutomationProperties.Name="Browser Remote" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding BrowserPath}" PlaceholderText="{Binding BrowserPathHint}" AutomationProperties.Name="Browser path" />
                  <Button Grid.Column="1" IsEnabled="{Binding CanBrowseParent}" Content="↑" Click="BrowseParentClicked" AutomationProperties.Name="Browse parent folder" />
                </Grid>
                <TextBox Text="{Binding BrowserFilter}" PlaceholderText="{Binding BrowserFilterHint}" AutomationProperties.Name="Filter current remote folder" />
                <TextBlock Text="{Binding BrowserEmptyText}" IsVisible="{Binding BrowserEmptyText}" Opacity="0.72" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding NewBrowserFolderName}" PlaceholderText="{Binding NewBrowserFolderHint}" AutomationProperties.Name="New remote folder name" />
                  <Button Grid.Column="1" IsEnabled="{Binding CanCreateBrowserFolder}" Content="{Binding CreateBrowserFolderLabel}" Click="CreateBrowserFolderClicked" AutomationProperties.Name="Create remote folder" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ListBox ItemsSource="{Binding BrowserItems}" SelectedItem="{Binding SelectedBrowserItem}" DisplayMemberBinding="{Binding DisplayName}" AutomationProperties.Name="Remote files" />
                  <Button Grid.Column="1" VerticalAlignment="Top" IsEnabled="{Binding CanOpenBrowserFolder}" Content="{Binding BrowserOpenLabel}" Click="OpenBrowserFolderClicked" AutomationProperties.Name="Open selected folder" />
                </Grid>
                <Border Classes="status" Background="{DynamicResource CardBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding BrowserSelectionHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BrowserSelectionDetails}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button IsEnabled="{Binding CanDownloadBrowserSelection}" Content="{Binding BrowserDownloadSelectedLabel}" Click="DownloadBrowserSelectionClicked" AutomationProperties.Name="Download selected remote item" />
                  <Button IsEnabled="{Binding CanUseBrowserSelectionForTransfer}" Content="{Binding BrowserUseAsTransferSourceLabel}" Click="UseBrowserSelectionClicked" AutomationProperties.Name="Use selected item as transfer source" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding BrowserDeleteConfirmation}" PlaceholderText="{Binding BrowserDeleteConfirmationHint}" AutomationProperties.Name="Remote file delete confirmation" />
                  <Button Grid.Column="1" IsEnabled="{Binding CanDeleteBrowserFile}" Content="{Binding DeleteBrowserFileLabel}" Click="DeleteBrowserFileClicked" AutomationProperties.Name="Delete selected remote file" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding BrowserRenameNewName}" PlaceholderText="{Binding BrowserRenameNewNameHint}" AutomationProperties.Name="New remote file name" />
                  <Button Grid.Column="1" IsEnabled="{Binding CanRenameBrowserFile}" Content="{Binding RenameBrowserFileLabel}" Click="RenameBrowserFileClicked" AutomationProperties.Name="Rename selected remote file" />
                </Grid>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsActivityJourney}" Spacing="10">
                <TextBlock Text="{Binding ActivityEmptyText}" IsVisible="{Binding ActivityEmptyText}" Opacity="0.72" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding CopyRunOptions}" SelectedItem="{Binding SelectedCopyRun}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding CopyRunHint}" AutomationProperties.Name="Running transfers" />
                  <Button Grid.Column="1" IsEnabled="{Binding CanCancelSelectedCopy}" Content="{Binding CancelCopyLabel}" Click="CancelSelectedCopyClicked" AutomationProperties.Name="Cancel selected transfer" />
                </Grid>
                <ListBox ItemsSource="{Binding ActivityRows}" AutomationProperties.Name="Recent activity" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsSettingsJourney}" Spacing="10">
                <TextBlock Text="{Binding SettingsHostStatus}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding SettingsVaultStatus}" />
                <TextBlock Text="{Binding SettingsRcloneStatus}" />
                <TextBlock Text="{Binding SettingsWinFspStatus}" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsMountJourney}" Spacing="10">
                <Border Classes="status" Background="{DynamicResource CardBrush}">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding MountPrerequisiteHeading}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding MountPrerequisiteStatus}" Foreground="{Binding MountPrerequisiteBrush}" />
                      <TextBlock IsVisible="{Binding CanInstallWinFsp}" Text="{Binding WinFspStableNotice}" TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                    <Button Grid.Column="1" IsVisible="{Binding CanInstallWinFsp}" Content="{Binding InstallWinFspLabel}" Click="InstallWinFspClicked" />
                    <Button Grid.Column="2" Content="{Binding RedetectLabel}" Click="RedetectClicked" />
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding MountProfiles}" SelectedItem="{Binding SelectedMountProfile}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding MountProfileHint}" AutomationProperties.Name="Saved Mount Profiles" />
                  <Button Grid.Column="1" Content="{Binding NewMountProfileLabel}" Click="NewMountProfileClicked" />
                  <Button Grid.Column="2" Content="{Binding SaveMountProfileLabel}" Click="SaveMountProfileClicked" />
                  <Button Grid.Column="3" IsEnabled="{Binding HasSelectedMountProfile}" Content="{Binding DeleteMountProfileLabel}" Click="DeleteMountProfileClicked" />
                </Grid>
                <TextBox Text="{Binding MountProfileName}" PlaceholderText="{Binding MountProfileNameHint}" AutomationProperties.Name="Mount Profile name" />
                <ComboBox ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding MountRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding MountRemoteHint}" AutomationProperties.Name="Mount Remote" />
                <TextBox Text="{Binding MountSubpath}" PlaceholderText="{Binding MountSubpathHint}" AutomationProperties.Name="Mount subpath" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding MountPresentationOptions}" SelectedItem="{Binding MountPresentation}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding MountPresentationHeading}" AutomationProperties.Name="Mount presentation type" />
                  <TextBox Grid.Column="1" Text="{Binding MountVolumeName}" PlaceholderText="{Binding MountVolumeNameHint}" AutomationProperties.Name="Mount volume name" />
                </Grid>
                <Grid IsVisible="{Binding IsMountDrivePresentation}" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding MountDriveSelectionOptions}" SelectedItem="{Binding MountDriveSelection}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding MountDriveSelectionHeading}" AutomationProperties.Name="Mount drive assignment" />
                  <ComboBox Grid.Column="1" IsVisible="{Binding IsPreferredDriveLetter}" ItemsSource="{Binding MountDriveLetters}" SelectedItem="{Binding MountDriveLetter}" PlaceholderText="{Binding MountDriveLetterHeading}" AutomationProperties.Name="Mount drive letter" />
                </Grid>
                <Grid IsVisible="{Binding IsFixedDirectoryMount}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding MountFixedDirectoryPath}" IsReadOnly="True" PlaceholderText="{Binding MountFixedDirectoryHint}" AutomationProperties.Name="Mount fixed directory" />
                  <Button Grid.Column="1" Content="{Binding PickMountDirectoryLabel}" Click="PickMountDirectoryClicked" />
                </Grid>
                <TextBlock Text="{Binding MountCachePresetHeading}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding MountCachePresetOptions}" SelectedItem="{Binding MountCachePreset}" DisplayMemberBinding="{Binding DisplayName}" AutomationProperties.Name="Mount cache and write preset" />
                <Border Classes="status" Background="{DynamicResource CardBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MountReadOnlyPresetLabel}" Foreground="MediumSeaGreen" />
                    <TextBlock Text="{Binding MountReadOnlyPresetDescription}" TextWrapping="Wrap" Opacity="0.72" />
                  </StackPanel>
                </Border>
                <Border Classes="status" Background="{DynamicResource CardBrush}" Opacity="0.68">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding MountStandardPresetLabel}" Foreground="DarkOrange" />
                    <TextBlock Text="{Binding MountMaximumPresetLabel}" Foreground="DarkOrange" />
                    <TextBlock Text="{Binding MountWritePresetExplanation}" TextWrapping="Wrap" Opacity="0.78" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding MountReadOnlyNotice}" TextWrapping="Wrap" Opacity="0.72" />
                <TextBlock Text="{Binding MountStatus}" AutomationProperties.LiveSetting="Polite" />
                <Border Classes="status" Background="{DynamicResource CardBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MountVfsHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MountVfsStatus}" Foreground="{Binding MountVfsStatusBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding RemoteSummary}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" IsEnabled="{Binding IsJourneyPrimaryEnabled}" Content="{Binding JourneyPrimaryAction}" Click="JourneyPrimaryClicked" />
                <Button IsVisible="{Binding IsAdvancedOptionsAvailable}" Content="{Binding AdvancedOptionsLabel}" Click="AdvancedOptionsClicked" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
