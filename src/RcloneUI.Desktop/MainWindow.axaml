<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RcloneUI.Desktop.Presentation"
        x:Class="RcloneUI.Desktop.MainWindow"
        x:DataType="vm:DesktopShellState"
        Width="1180" Height="760" MinWidth="900" MinHeight="620"
        Title="Rclone UI" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="64,*" ColumnDefinitions="232,*">
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" Padding="16,22">
      <Grid RowDefinitions="Auto,24,*,Auto">
        <StackPanel>
          <TextBlock Text="Rclone UI" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EditionLabel}" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <ListBox Grid.Row="2" SelectedIndex="0" SelectionChanged="NavigationChanged" Background="Transparent" BorderThickness="0">
          <ListBoxItem Tag="Home" Content="{Binding NavHome}" />
          <ListBoxItem Tag="Remotes" Content="{Binding NavRemotes}" />
          <ListBoxItem Tag="Transfers" Content="{Binding NavTransfers}" />
          <ListBoxItem Tag="Browser" Content="{Binding NavBrowser}" />
          <ListBoxItem Tag="Mounts" Content="{Binding NavMounts}" />
          <ListBoxItem Tag="Schedules" Content="{Binding NavSchedules}" />
          <ListBoxItem Tag="Activity" Content="{Binding NavActivity}" />
          <ListBoxItem Tag="Settings" Content="{Binding NavSettings}" />
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="8">
          <Border Classes="status" Background="{DynamicResource CardBrush}">
            <StackPanel>
              <TextBlock Text="{Binding HostHeading}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding StatusBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="status" Background="{DynamicResource CardBrush}">
            <StackPanel>
              <TextBlock Text="{Binding VaultHeading}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VaultStatusLabel}" Foreground="{Binding VaultStatusBrush}" />
              <Button IsVisible="{Binding CanLockVault}" Content="{Binding LockVaultLabel}" Margin="0,6,0,0" Click="LockVaultClicked" />
            </StackPanel>
          </Border>
          <Button Content="{Binding ExitLabel}" HorizontalAlignment="Stretch" Click="ExitClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Padding="28,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SessionLabel}" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding NotificationsLabel}" Margin="8,0" />
        <Button Grid.Column="2" Content="中 / EN" Click="LanguageClicked" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28" Spacing="20">
        <Border IsVisible="{Binding NeedsAttention}" Classes="attention">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding AttentionTitle}" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding AttentionDetail}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBox IsVisible="{Binding IsVaultLocked}" Text="{Binding MasterPassword}" PasswordChar="●" PlaceholderText="{Binding MasterPasswordHint}" MaxLength="1024" Margin="0,10,16,0" AutomationProperties.Name="Master Password" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding AttentionAction}" Click="AttentionClicked" />
          </Grid>
        </Border>

        <StackPanel IsVisible="{Binding IsHome}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding HomeHeading}" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HomeDescription}" Opacity="0.68" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{Binding NewTaskLabel}" Click="NewTaskClicked" />
          </Grid>
          <UniformGrid Columns="4" Rows="1">
            <Button Classes="shortcut" Content="{Binding ShortcutTransfer}" Tag="Transfers" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutBrowse}" Tag="Browser" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutMount}" Tag="Mounts" Click="ShortcutClicked" />
            <Button Classes="shortcut" Content="{Binding ShortcutRemote}" Tag="Remotes" Click="ShortcutClicked" />
          </UniformGrid>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TransferCardHeading}" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding RunningTasksLabel}" /></Grid>
                <Border Classes="empty"><TextBlock Text="{Binding EmptyTaskText}" TextWrapping="Wrap" /></Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding RemoteHealthHeading}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding NoRemoteText}" />
                <Button Content="{Binding OpenRemoteWizardLabel}" Tag="Remotes" Click="ShortcutClicked" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsJourney}" Spacing="18">
          <TextBlock Text="{Binding JourneyHeading}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding JourneyDescription}" FontSize="15" Opacity="0.72" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding JourneyStatus}" FontWeight="SemiBold" FontSize="17" />
              <TextBlock Text="{Binding JourneyActionHint}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding IsRemoteJourney}" Spacing="10">
                <TextBlock Text="{Binding QuickAddHeading}" FontWeight="SemiBold" />
                <TextBox PlaceholderText="{Binding RemoteDisplayNameHint}" Text="{Binding RemoteDisplayName}" AutomationProperties.Name="Remote display name" />
                <ComboBox ItemsSource="{Binding TokenProviderTypes}" SelectedItem="{Binding RemoteProviderType}" AutomationProperties.Name="Remote provider" />
                <TextBox PlaceholderText="{Binding RemoteTokenHint}" Text="{Binding RemoteToken}" PasswordChar="●" MaxLength="16384" AutomationProperties.Name="Remote token" />
                <TextBlock Text="{Binding RemoteHelpText}" TextWrapping="Wrap" Opacity="0.7" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsTransferJourney}" Spacing="10">
                <TextBlock Text="{Binding TransferFormHeading}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding TransferModes}" SelectedItem="{Binding TransferMode}" AutomationProperties.Name="Transfer mode" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding CopySourceRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding SourceRemoteHint}" AutomationProperties.Name="Copy source Remote" />
                  <TextBox Grid.Column="1" PlaceholderText="{Binding SourcePathHint}" Text="{Binding CopySourcePath}" AutomationProperties.Name="Copy source path" />
                </Grid>
                <Grid IsVisible="{Binding IsDownloadMode}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding DownloadDestinationPath}" IsReadOnly="True" PlaceholderText="{Binding DownloadFolderHint}" AutomationProperties.Name="Download destination folder" />
                  <Button Grid.Column="1" Content="{Binding PickFolderLabel}" Click="PickDownloadFolderClicked" />
                </Grid>
                <Grid IsVisible="{Binding IsRemoteCopyMode}" ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding RemoteOptions}" SelectedItem="{Binding CopyDestinationRemote}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding DestinationRemoteHint}" AutomationProperties.Name="Copy destination Remote" />
                  <TextBox Grid.Column="1" PlaceholderText="{Binding DestinationPathHint}" Text="{Binding CopyDestinationPath}" AutomationProperties.Name="Copy destination path" />
                </Grid>
                <TextBlock Text="{Binding CopyStatus}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <TextBlock Text="{Binding RemoteSummary}" />
              <TextBlock Text="{Binding LastAction}" Opacity="0.7" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="{Binding JourneyPrimaryAction}" Click="JourneyPrimaryClicked" />
                <Button Content="{Binding AdvancedOptionsLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
